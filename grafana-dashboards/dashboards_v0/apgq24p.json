                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "sort(\n  max by (cluster) (\n    up{job=\"prometheus-kube-prometheus-prometheus\", namespace=\"monitoring\"}\n    or\n    up{pod=~\"opentelemetry-kube-stack-prometheus-collector-.*\", namespace=\"otel-system\"}\n  )\n  or\n  (\n    max by (cluster) (\n      max_over_time(up{job=\"prometheus-kube-prometheus-prometheus\", namespace=\"monitoring\"}[5d])\n      or\n      max_over_time(up{pod=~\"opentelemetry-kube-stack-prometheus-collector-.*\", namespace=\"otel-system\"}[5d])\n    ) * 0\n  )\n)",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "__auto"
                      },
                      "version": "v0"
                    },
                    "refId": "U"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": [
                {
                  "group": "joinByField",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "byField": "wk",
                      "mode": "outer"
                    }
                  }
                },
                {
                  "group": "organize",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "Time 3": true,
                        "Value #R": false,
                        "wk": true,
                        "workload 2": true,
                        "workload 3": true,
                        "workload_kind 2": true,
                        "workload_kind 3": true
                      },
                      "includeByName": {},
                      "indexByName": {
                        "limits": 4,
                        "request": 3,
                        "used": 2,
                        "workload": 1,
                        "workload_kind": 0
                      },
                      "renameByName": {
                        "Value #L": "limits",
                        "Value #R": "request",
                        "Value #U": "used"
                      }
                    }
                  }
                }
              ]
            }
          },
          "description": "This table displays the current status (UP/DOWN) of all clusters that have been active in the last 5 days. If a cluster stops sending metrics for more than 5 days, It will disappear from the list.",
