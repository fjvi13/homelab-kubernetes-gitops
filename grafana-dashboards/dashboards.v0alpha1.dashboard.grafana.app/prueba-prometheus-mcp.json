{
  "apiVersion": "dashboard.grafana.app/v0alpha1",
  "kind": "Dashboard",
  "metadata": {
    "annotations": {
      "grafana.app/message": "Crear Dashboard básico de prueba con métrica Prometheus"
    },
    "labels": {},
    "name": "prueba-prometheus-mcp",
    "namespace": "default"
  },
  "spec": {
    "panels": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "PA5392E10C0F059AB"
        },
        "description": "Panel de prueba creado mediante el MCP de Grafana",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "short"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 0
        },
        "id": 1,
        "options": {
          "legend": {
            "calcs": [],
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "expr": "up",
            "legendFormat": "{{job}} / {{instance}}",
            "range": true,
            "refId": "A"
          }
        ],
        "title": "Disponibilidad de objetivos Prometheus",
        "type": "timeseries"
      }
    ],
    "refresh": "30s",
    "schemaVersion": 39,
    "tags": [
      "mcp",
      "prueba"
    ],
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timezone": "browser",
    "title": "Prueba Prometheus MCP"
  }
}
